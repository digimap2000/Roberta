	(text "These are bulk decoupling \nfor the 12V domain."
		(exclude_from_sim no)
		(at 46.736 98.552 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "18909b0d-fd22-4ee1-8594-ca456da75f0c")
	)
	(text "Broken out into individual two pin JST PHs as each\none is likely going somewhere completely different \nand a loom would be overkill here."
		(exclude_from_sim no)
		(at 330.454 74.168 90)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1dc5b7dd-8b07-4a5b-a81d-59f4da95cffc")
	)
	(text "The ALARM and BRK (in position) signals are opto \noutputs in the CL57T so we pull them high and it \nswitches them to ground when active."
		(exclude_from_sim no)
		(at 330.708 117.856 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "780a3088-5f5f-4fe1-b20d-81fbeeb19919")
	)
	(text "TE Micro Match\nModern 1.27mm IDC Header\nAdditional Debug header"
		(exclude_from_sim no)
		(at 30.48 157.48 90)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a9f82342-ced7-421d-9416-6d9c3f6f1911")
	)
	(text "These are laid out in the same order as the CL57T\nso the wiring is neat. But I still can't bring myself\nto use screw termninals so these are crimped JST PHs."
		(exclude_from_sim no)
		(at 331.47 103.886 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b4f3bac0-94fd-4a58-800d-4d1388cdb032")
	)
	(text "This one is OK to use a single \n8 way connector as it will be \nconnected to the four pairs of a Cat5\ncable all going off to the axis joint."
		(exclude_from_sim no)
		(at 108.712 262.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "c0ca622e-c34c-4bd2-9690-90fb3d6d3bd8")
	)
	(text "Single ended signals fine within a PCB cluster\nand the master will provide the pull down and any\nRC debouncing if required,"
		(exclude_from_sim no)
		(at 156.718 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "f6fcbced-a766-4a8d-b163-b66357cf74bd")
	)
