{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roberta",
  "version": "0.1.0",
  "identifier": "com.roberta.macos",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Roberta",
        "width": 1600,
        "height": 1024,
        "minWidth": 1200,
        "minHeight": 780,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}

